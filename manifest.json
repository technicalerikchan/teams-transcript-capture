{
  "manifest_version": 3,
  "name": "Teams Transcript Capture",
  "version": "0.2.1",
  "description": "Auto-capture of Microsoft Teams (web) live-caption transcripts: auto start/stop, meeting-aware naming, dual-tenant OneDrive routing, M365 Copilot minutes bridge.",
  "permissions": [
    "storage",
    "tabs"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Teams Transcript Capture"
  },
  "content_scripts": [
    {
      "matches": [
        "https://teams.microsoft.com/*",
        "https://*.teams.microsoft.com/*",
        "https://teams.live.com/*",
        "https://teams.cloud.microsoft/*",
        "https://*.cloud.microsoft/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
